# ========================================
# Telegram Bot 环境配置文件
# 复制此文件为 env 或 .env 并填写配置
# ========================================

# ==================== 必填配置 ====================

# Telegram Bot Token (必填)
# 从 @BotFather 获取
BOT_TOKEN=your_bot_token_here

# 超级管理员ID (必填)
# 你的Telegram用户ID
SUPER_ADMIN_ID=your_telegram_id_here

# ==================== 可选配置 ====================

# 源频道ID（逗号分隔）
SOURCE_CHANNELS=

# 目标频道ID（逗号分隔）
TARGET_CHANNELS=

# 数据库路径
DB_PATH=./data/bot.json

# 是否运行
IS_RUNNING=true

# ==================== 持久化存储与自愈配置 ====================

# 持久化资料频道 ID (Bot 往这里发，锁定 source_chat_id / source_msg_id)
PERSISTENT_CHANNEL_ID=-1001234567890

# 关联讨论群组 ID (UserBot 在这里监听，可选)
PERSISTENT_GROUP_ID=-1000987654321

# 换 bot 认领：新 Token + 认领私聊目标（需先 /start）
# NEW_BOT_TOKEN=
# CLAIM_TO_CHAT_ID=

# 命令：
#   npm run vault:status
#   npm run vault:sync
#   npm run vault:claim

# ==================== 多管理员隔离配置（可选） ====================

# 额外管理员 ID（逗号分隔）
# 示例: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# 每个管理员独立发布频道映射（覆盖全局 CHANNEL_IDS）
# 格式: 管理员ID=频道1,频道2;管理员ID=频道3
# 示例: ADMIN_CHANNEL_MAP=123456789=-100111,-100222;987654321=-100333
ADMIN_CHANNEL_MAP=

# 每个管理员独立持久化备份频道映射（覆盖全局 PERSISTENT_CHANNEL_ID）
# 格式: 管理员ID=频道ID;管理员ID=频道ID
# 示例: ADMIN_PERSISTENT_CHANNEL_MAP=123456789=-100999;987654321=-100888
ADMIN_PERSISTENT_CHANNEL_MAP=

# ==================== 高级加速配置 ====================

# Telegram API 中转代理 (重要：国内服务器必填)
# 推荐使用公用的加速地址或自建中转
# 示例: https://tgproxy.libv.it
TELEGRAM_API_ROOT=https://api.telegram.org

# ==================== 图片/视频水印 ====================

# 启用后，新上传自动水印；管理员通过 /watermark 一键迁移旧资料
WATERMARK_ENABLED=false
WATERMARK_TEXT=@your_channel
WATERMARK_OPACITY=0.35
WATERMARK_VIDEO_PERIOD_SECONDS=8
WATERMARK_VIDEO_CRF=23
WATERMARK_VIDEO_PRESET=veryfast
# 单线程 + 后台低优先级，避免批量处理影响机器人响应
WATERMARK_FFMPEG_THREADS=1
WATERMARK_JOB_TIMEOUT_SECONDS=3600
WATERMARK_VERSION=1

# ========================================
# 配置说明:
# 1. 获取Bot Token: 与@BotFather对话，创建机器人
# 2. 获取用户ID: 与@userinfobot对话查看
# 3. 频道ID: 通常是负数，如 -1001234567890
# ========================================
