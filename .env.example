# ========== 复制为 .env 后填写真实值（勿把 .env 提交到 Git）==========

BOT_TOKEN=your_bot_token_here
SUPER_ADMIN_ID=your_telegram_numeric_id
CHANNEL_IDS=-100xxxxxxxxxx
DATABASE_PATH=./data/bot.db
NODE_ENV=development
LOG_LEVEL=info

# 备份金库（换 Token / 迁 bot 必填）
PERSISTENT_CHANNEL_ID=-100yyyyyyyyyy
# PERSISTENT_GROUP_ID=-100zzzzzzzzzz
# ADMIN_PERSISTENT_CHANNEL_MAP=

# 新 bot 认领（npm run vault:claim）
# NEW_BOT_TOKEN=
# CLAIM_TO_CHAT_ID=

# 流程提示：
# 1. npm run vault:status
# 2. npm run vault:sync
# 3. npm run vault:claim
# 4. 将 BOT_TOKEN 换成新 Token 后重启

# 可选
# ADMIN_IDS=
# ADMIN_CHANNEL_MAP=
# TELEGRAM_API_ROOT=https://api.telegram.org
# DOMAIN=http://localhost:3000

# ========== 图片/视频水印 ==========
# 启用后，新上传的照片/视频会在入库前自动水印；管理员可用 /watermark 迁移旧资料
WATERMARK_ENABLED=false
WATERMARK_TEXT=@your_channel
WATERMARK_OPACITY=0.35
# 视频从左到右再返回的完整周期（秒）
WATERMARK_VIDEO_PERIOD_SECONDS=8
# 画质：越小越清晰、文件越大，建议 21-25
WATERMARK_VIDEO_CRF=23
# 速度/CPU 平衡：ultrafast/superfast/veryfast/faster/fast/medium
WATERMARK_VIDEO_PRESET=veryfast
# 为避免影响机器人响应，建议保持 1
WATERMARK_FFMPEG_THREADS=1
WATERMARK_JOB_TIMEOUT_SECONDS=3600
# 本地 Bot API 的单文件处理上限；官方云端下载仍受 20MB 限制
WATERMARK_MAX_INPUT_MB=2000
# 修改水印样式或文字后递增版本，可重新处理旧资料
WATERMARK_VERSION=1
# Docker 已自动安装并发现中文字体；仅自定义部署时需要填写
# FFMPEG_PATH=ffmpeg
# WATERMARK_FONT_FILE=/usr/share/fonts/noto/NotoSansCJK-Regular.ttc
# WATERMARK_TEMP_DIR=/tmp
